# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_PUBLISHABLE_KEY=
# Optional: set to true to make Home require the local server (http://localhost:3001) before
# showing the app. Off by default because the deployed site has no local server.
# REACT_APP_LOCAL_SERVER_CHECK=true
